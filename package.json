{
  "name": "ikuzo-kora",
  "version": "1.0.0",
  "private": true,
  "description": "sixties KITSCH — Yakuza-style YouTube channel intro (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render KitschIntro out/intro.mp4",
    "render:montage": "remotion render KitschMontage out/montage.mp4",
    "still": "remotion still KitschIntro out/still.png",
    "typecheck": "tsc --noEmit",
    "assets": "python3 scripts/process_assets.py",
    "sfx": "python3 scripts/make_sfx.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
